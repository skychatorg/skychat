{
    "env": {
        "browser": true,
        "es2021": true,
        "node": true,
        "serviceworker": true
    },
    "root": true,
    "parser": "vue-eslint-parser",
    "parserOptions": {
        "parser": "@typescript-eslint/parser"
    },
    "extends": [
        "eslint:recommended",
        "plugin:vue/vue3-recommended",
        "prettier"
    ],
    "plugins": ["prettier", "@typescript-eslint"],
    "overrides": [
        // The core rule flags names in TypeScript signatures, interfaces and enums
        {
            "files": ["*.ts"],
            "rules": {
                "no-unused-vars": "off",
                "@typescript-eslint/no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }]
            }
        },
        // Route views are single words by design
        {
            "files": ["app/client/src/views/*.vue"],
            "rules": { "vue/multi-word-component-names": "off" }
        }
    ],
    "rules": {
        "prettier/prettier": [
            "error",
            {
                "singleQuote": true,
                "semi": true,
                "trailingComma": "all",
                "printWidth": 140,
                "tabWidth": 4,
                "useTabs": false,
                "bracketSpacing": true,
                "arrowParens": "always",
                "endOfLine": "auto"
            }
        ]
    },
    "globals": {
        "NodeJS": true
    }
}
